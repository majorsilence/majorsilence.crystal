<Project>

  <PropertyGroup>
    <Version>0.4.0</Version>
    <Authors>Peter Gill</Authors>
    <Company>Majorsilence</Company>
    <PackageProjectUrl>https://github.com/majorsilence/majorsilence.crystal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/majorsilence/majorsilence.crystal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Default; the packable library/tool projects opt back in individually. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- On .NET 11 async methods compile to runtime async: the runtime suspends and resumes
       them itself, with no compiler-built state machine. TargetFramework is a global
       property in each multi-targeted inner build, so it is already known here. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

</Project>
