<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Majorsilence.Crystal.RptEngine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Crystal.Model\Majorsilence.Crystal.Model.csproj" />
    <ProjectReference Include="..\Majorsilence.Crystal.Parser\Majorsilence.Crystal.Parser.csproj" />
    <ProjectReference Include="..\Majorsilence.Crystal.Converter\Majorsilence.Crystal.Converter.csproj" />
    <ProjectReference Include="..\Majorsilence.Crystal.Runtime\Majorsilence.Crystal.Runtime.csproj" />
  </ItemGroup>

  <!--
    ReportingSource: a local checkout of the Reporting repository to build against instead of
    the published engine package, for measuring an engine change before it is released, e.g.
      dotnet test tests/Majorsilence.Crystal.VisualRegression.Tests -p:ReportingSource=A:\source\repos\Reporting
    Unset (the default, and always in CI), the package below is used.
  -->
  <ItemGroup Condition="'$(ReportingSource)' == ''">
    <!-- From 27 the engine draws through SkiaSharp in every build, so the plain package is the
         cross-platform one; Majorsilence.Reporting.RdlEngine.SkiaSharp is now only an alias for it. -->
    <PackageReference Include="Majorsilence.Reporting.RdlEngine" Version="27.0.0-alpha.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReportingSource)' != ''">
    <ProjectReference Include="$(ReportingSource)\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Renders Crystal Reports .rpt files (with runtime data/parameter/formula overrides) to PDF using Majorsilence.Crystal's own parser and converter plus the Majorsilence.Reporting RDL engine — no dependency on the real, licensed CrystalDecisions.CrystalReports.Engine runtime.</Description>
  </PropertyGroup>

</Project>
