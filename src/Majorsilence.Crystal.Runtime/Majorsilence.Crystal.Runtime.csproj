<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Crystal.Model\Majorsilence.Crystal.Model.csproj" />
    <ProjectReference Include="..\Majorsilence.Crystal.Converter\Majorsilence.Crystal.Converter.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Engine-agnostic runtime-override application and render preparation for a parsed Crystal Reports .rpt (RuntimeOverrides, ReportAnalysis, RenderPrep) — no dependency on any specific RDL render engine, so it can be shared between headless (Majorsilence.Crystal.RptEngine) and interactive (Majorsilence.Crystal.UI.Avalonia) consumers.</Description>
  </PropertyGroup>

</Project>
